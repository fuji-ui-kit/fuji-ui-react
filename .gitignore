# dependencies
/node_modules
/fixtures/*/node_modules
# Unanchored, so a workspace's own install is covered too. Without this
# `mcp/node_modules` is trackable, and staging it once buries the authored
# change under tens of thousands of vendored lines.
node_modules/

# build output
/dist
/mcp/dist
/fixtures/*/dist
*.tsbuildinfo

# testing
/coverage

# storybook
/storybook-static
/.storybook/generated

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env*

# editor
.vscode/*
!.vscode/extensions.json

# package artifacts
*.tgz

# Local appearance gallery (scripts/render-gallery.mjs)
.gallery/
