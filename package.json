{
  "name": "@fujiui/react",
  "version": "0.2.1",
  "description": "Fuji UI - a themeable, accessible React component system (light/dark theme, solid/glass material, cornered/soft radius, regular/floating elevation).",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Fuji UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuji-ui-kit/fuji-ui-react.git"
  },
  "homepage": "https://fujiui.com/",
  "bugs": {
    "url": "https://github.com/fuji-ui-kit/fuji-ui-react/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "tailwind",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./props.json": "./dist/props.json",
    "./registry.json": "./dist/registry.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:props && npm run build:registry",
    "build:props": "node scripts/gen-props.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:mcp": "tsc -p mcp/tsconfig.json",
    "build:js": "tsup",
    "build:css": "node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "dev:link": "node scripts/watch-css.mjs & node scripts/sync-linked.mjs & tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.storybook.json && tsc --noEmit -p mcp/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "skills:check": "node scripts/check-skill-sync.mjs",
    "fixtures:pack": "node scripts/pack-fixtures.mjs",
    "storybook": "npm run build:css && node scripts/build-storybook-css.mjs && storybook dev -p 6006",
    "storybook:build": "npm run build:css && node scripts/build-storybook-css.mjs && storybook build",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.15.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.6.0",
    "tailwindcss": "4.1.18",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
